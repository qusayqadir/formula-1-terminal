# Google Maps JavaScript API key — powers the Team Profiles factory map
# (frontend/src/features/team-profiles/FactoryMap.tsx) and the Live Dashboard's
# real satellite/street basemap under the track (frontend/src/features/live/widgets/TrackMap.tsx).
#
# Get one at https://console.cloud.google.com/google/maps-apis/credentials
#   1. Create (or pick) a project.
#   2. APIs & Services -> Library -> enable "Maps JavaScript API".
#   3. APIs & Services -> Credentials -> Create credentials -> API key.
#   4. (Recommended) restrict the key to "Maps JavaScript API" and to your
#      dev/prod origins (HTTP referrers) under the key's settings.
#
# Free tier covers normal dev/testing use (Google's Maps Platform has a
# no-credit-card-required free monthly usage tier as of 2026).
VITE_GOOGLE_MAPS_API_KEY=

# Optional. Without this, the live track basemap still works but Google's
# own POI pins (nearby restaurants, landmarks, "temporarily closed"
# businesses, etc.) render on top of the satellite/street imagery —
# non-clickable (the app disables clickableIcons), but still visible.
#
# To remove them entirely, create a custom Map ID with a style that hides
# POI + transit labels:
#   1. https://console.cloud.google.com/google/maps-apis/studio/maps
#      -> Map IDs -> Create Map ID (any map type; JavaScript platform).
#   2. Map Styles -> Create new style -> under "Points of interest" and
#      "Transit", set label + icon visibility to Off -> Save.
#   3. Associate that style with the Map ID you created, then paste the
#      Map ID (not the style ID) below.
VITE_GOOGLE_MAPS_MAP_ID=
